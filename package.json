{
  "name": "@neoworks-dev/oauth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:ui && bun run build:css",
    "build:ui": "vite build",
    "build:css": "tailwindcss -i styles/vault.css -o handlers/static/assets/neoworks.css",
    "watch:ui": "vite build --watch",
    "watch:css": "tailwindcss -i styles/vault.css -o handlers/static/assets/neoworks.css --watch"
  },
  "devDependencies": {
    "@neoworks-dev/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/cli": "^4.2.2",
    "svelte": "^5.55.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.7"
  }
}
