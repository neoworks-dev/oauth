PORT=8080
KEY_PATH=../api/keys/auth.pem
REDIS_URL=localhost:6379
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
DEBUG=true

# SMTP — transactional email (signup verification + password reset codes).
# When unset, email degrades to a no-op that logs each message, so signup/reset
# work in dev (DEBUG=true also echoes the code back in API responses).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NeoWorks <no-reply@neoworks.io>

# Vault origin (serves the account vault; route vault.<BASE_DOMAIN> to this port)
VAULT_PORT=8087
# VAULT_URL=https://vault.neoworks.localhost
# API_URL=https://api.neoworks.localhost
# OAuth client of the Neoworks Authenticator (only it may deliver an AMK handover)
# AUTHENTICATOR_CLIENT_ID=neoworks-authenticator
# PRELOGIN_SECRET=   # derived from the signing key when unset

# Escrow (optional). The oauth service talks to cmd/escrow with the shared token.
# ESCROW_URL=http://localhost:8090
# ESCROW_SERVICE_TOKEN=
# cmd/escrow only:
# ESCROW_PORT=8090
# ESCROW_DEV=true            # development service key and an auto-created KMS key file
# ESCROW_KMS_KEY_FILE=./keys/escrow-kms.key
# ESCROW_SURREAL_NS=escrow
# ESCROW_WAIT=168h
